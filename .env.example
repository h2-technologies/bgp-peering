# Copy to .env for local development. Every value here maps to a key in
# Rocket.toml; the ROCKET_ prefix is what makes it override the file.

# Our networks. Overlap is computed across all of them, and PeeringDB
# affiliation with any one of them grants access to the admin queue.
ROCKET_LOCAL_ASNS=[64500]

# From https://www.peeringdb.com/oauth2/applications/
# Redirect URI must be exactly <ROCKET_PUBLIC_URL>/auth/callback
ROCKET_OIDC_CLIENT_ID=
ROCKET_OIDC_CLIENT_SECRET=

# The origin browsers actually use. With `trunk serve` this is :8080, because
# that is where the browser is even though Rocket listens on :8000.
ROCKET_PUBLIC_URL=http://localhost:8080

# Optional: raises the PeeringDB rate limit well above the anonymous allowance.
# ROCKET_PEERINGDB_API_KEY=

# Required for `ROCKET_PROFILE=release`; generate with `openssl rand -base64 32`.
# ROCKET_SECRET_KEY=
